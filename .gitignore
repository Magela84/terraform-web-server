# Local .terraform directories
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Ignore sensitive variable files
*.tfvars
!terraform.tfvars  # (Include this if you want terraform.tfvars tracked, otherwise remove the !)

# Terraform plan output
*.tfplan

# .env files (if any)
.env

# Backup files
*.backup
*.bak

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db